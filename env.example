# Copy to .env and fill in real values. Never commit .env.
#   cp env.example .env
# Variables marked REQUIRED must be set for bip.core.settings.Settings to load.

# --- Storage -----------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co           # REQUIRED
SUPABASE_KEY=your-supabase-key                          # REQUIRED
SUPABASE_DB_PASSWORD=your-db-password                   # used by migration verify scripts only
PARQUET_BASE_PATH=data/cache
MODEL_DIR=models

# --- Data providers ------------------------------------------------------------
API_FOOTBALL_KEY=your-api-football-key                  # REQUIRED
ODDS_API_KEY=your-the-odds-api-key                      # REQUIRED
SPORTMONKS_API_KEY=your-sportmonks-key                  # live / in-play modules only
FLARESOLVERR_URL=http://localhost:8191/v1               # optional, scraping helpers

# --- LLM validator (optional) ----------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-key
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_FAILURE_MODE=filter                              # filter | skip
LEARNINGS_PATH=data/learnings/default.md

# --- Alert delivery (optional) ---------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHANNEL_ID=-1000000000000
TELEGRAM_OPS_CHANNEL_ID=-1000000000000
TELEGRAM_PRIMARY_CHANNEL_ID=-1000000000000              # live modules
TELEGRAM_DIAG_CHANNEL_ID=-1000000000000                 # live modules

# --- Sizing and monitoring -------------------------------------------------------
MAX_KELLY_FRACTION=0.25
RECONCILE_MAX_RETRIES=4
RECONCILE_RETRY_MINUTES=30
HEARTBEAT_FILE_PATH=/tmp/bip_heartbeat                  # /var/run/bip/heartbeat on a VPS
CLV_TREND_ALERT_THRESHOLD=1.0
CLV_TREND_COOLDOWN_HOURS=12
DRIFT_CHECK_MIN_PICKS_PER_WINDOW=30
DRIFT_ABSOLUTE_THRESHOLD_PP=2.0
DRIFT_STDEV_MULTIPLIER=1.5
DRIFT_STDEV_FLOOR_PP=1.0
LOG_LEVEL=INFO

# --- Live engine debug flags (optional) -----------------------------------------
V3_LIVE_OBSERVE=0
V3_LIVE_OBSERVE_LOG=
